# Backblaze B2 S3 credentials
# Get these from https://secure.backblaze.com/b2_buckets.htm → App Keys
# Copy this file to .dev.vars and fill in your actual values
S3_ACCESS_KEY_ID=your_application_key_id
S3_SECRET_ACCESS_KEY=your_application_key

# Optional (defaults to us-west-004)
# S3_REGION=us-west-004
