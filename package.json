{
  "name": "lexoshqip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portal për letërsinë shqipe të lirë dhe në domain publik",
  "scripts": {
    "dev": "npm run build:content && vite --host 0.0.0.0",
    "build": "npm run build:content && vite build",
    "build:content": "node scripts/build-content.mjs",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "smoke": "node scripts/render-smoke.mjs / Letërsia shqipe,Të gjitha epokat,Bota e Fëmijëve",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "epubjs": "^0.3.93",
    "flexsearch": "^0.7.31",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.3",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^3.0.0"
  }
}
